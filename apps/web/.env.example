# Required by the web app locally and in Vercel Production.
# These values must belong to the same Stocky Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: set only when serving Stocky from a custom root domain.
# NEXT_PUBLIC_ROOT_DOMAIN=stocky.example.com
# NEXT_PUBLIC_APP_DOMAIN=stocky.example.com

# Local-only development login. Never set these in Vercel Production.
# STOCKY_DEV_LOGIN_EMAIL=
# STOCKY_DEV_LOGIN_PASSWORD=

# Local-only database tooling for packages/db; Vercel does not need this.
# DATABASE_URL=postgresql://...

# Google OAuth credentials are configured in Supabase Authentication settings,
# not in the Stocky web deployment environment.
