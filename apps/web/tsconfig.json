{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@stocky/tokens": ["../../packages/tokens/src"],
      "@stocky/tokens/*": ["../../packages/tokens/src/*"],
      "@stocky/icons": ["../../packages/icons/src"],
      "@stocky/icons/*": ["../../packages/icons/src/*"],
      "@stocky/types": ["../../packages/types/src"],
      "@stocky/types/*": ["../../packages/types/src/*"],
      "@stocky/db": ["../../packages/db/src"],
      "@stocky/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
